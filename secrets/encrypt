#!/bin/sh
# Usage: secrets/encrypt <name> < plaintext   (writes secrets/<name>.age)
# Encrypts stdin to the recipients secrets.nix lists for <name>.age.
set -eu
dir=$(dirname "$0")
name=$1
recipients=$(mktemp)
trap 'rm -f "$recipients"' EXIT
nix eval --raw --file "$dir/secrets.nix" "\"$name.age\".publicKeys" \
  --apply 'keys: builtins.concatStringsSep "\n" keys + "\n"' >"$recipients"
nix run nixpkgs#age -- -R "$recipients" -o "$dir/$name.age"
echo "wrote $dir/$name.age" >&2
